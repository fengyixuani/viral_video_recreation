# 通用爆款复刻 —— 默认配置（非密钥项）
# 密钥与内网网关地址放 conf/config.local.env（不入库）或直接 export 环境变量。
# 优先级：环境变量 > config.local.env > 本文件。

WENCHAIN_BASE_URL=http://wenku-openai.baidu-int.com/wenchain/strategy
# WENCHAIN_API_KEY=<申请到的 channel>

TEXT_LLM_MODEL=ali-qwen3.7-max
VISION_LLM_MODEL=ali-qwen3.7-plus
AIGC_T2I_MODEL=doubao-seedream-5-0-260128
AIGC_I2V_MODEL=doubao-seedance-2-0

AIGC_T2I_SIZE=1664x2368
AIGC_ASPECT=9:16

# 理解类调用链路：gemini（默认，走 GEMINI_GATEWAY_URL）| qwen（走 wenchain）
AIGC_ENGINE=gemini
# 逗号分隔的内网网关列表，节点会漂移，逐个试
# GEMINI_GATEWAY_URL=http://10.0.0.1:8018,http://10.0.0.2:8534
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_TIMEOUT=300
GEMINI_RETRIES=3

# BOS 上传（把本地图/视频变成公网预签名 URL）
# BOS_ACCESS_KEY_ID / BOS_SECRET_ACCESS_KEY 只写在 config.local.env 里
# BOS_BUCKET=<bucket 名>
BOS_HOST=bj.bcebos.com
BOS_KEY_PREFIX=viral_video_recreation
BOS_URL_EXPIRE=-1
